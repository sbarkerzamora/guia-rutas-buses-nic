{
  "name": "eve-chat-template",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "build": "pnpm build:eve && pnpm build:web",
    "build:eve": "eve build",
    "build:web": "next build --turbopack apps/web",
    "db:generate": "drizzle-kit generate --config apps/web/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config apps/web/drizzle.config.ts",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push --config apps/web/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config apps/web/drizzle.config.ts",
    "dev": "next dev apps/web",
    "dev:eve": "eve dev",
    "dev:all": "vercel dev --local",
    "dev:web": "next dev apps/web",
    "start:eve": "eve start",
    "typecheck": "next typegen apps/web && tsgo --noEmit -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.69",
    "@neondatabase/serverless": "1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/engine-oniguruma": "4.5.0",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/connect": "^2.5.2",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.141",
    "assistant-ui": "^0.0.123",
    "better-auth": "1.7.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "eve": "^0.80.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "ogl": "^1.0.11",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "0.31.11",
    "just-bash": "^3.6.0",
    "microsandbox": "^0.5.10",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
